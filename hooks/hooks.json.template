{
  "description": "Environmental impact tracking hooks",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "__DIR__/scripts/track-usage.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "rm -f /tmp/claude-env-tracker-${session_id}.json",
            "async": true
          }
        ]
      }
    ]
  }
}
